{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clawback.local/schemas/finding.json",
  "title": "AuditFinding",
  "description": "Traceable audit discrepancy found by deterministic rules engine",
  "type": "object",
  "required": [
    "finding_id",
    "carrier_name",
    "invoice_number",
    "line_id",
    "shipment_id",
    "rule_id",
    "rule_type",
    "contract_page",
    "contract_clause_quote",
    "expected_amount",
    "billed_amount",
    "overcharge_amount",
    "calculation_math",
    "created_at"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique UUID for the finding"
    },
    "batch_id": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "carrier_name": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "line_id": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string"
    },
    "charge_code": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "description": "ID of the approved contract rule triggered"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "base_discount",
        "accessorial_rule",
        "fuel_surcharge",
        "dim_weight_divisor",
        "minimum_charge",
        "duplicate_charge",
        "claim_window_days"
      ]
    },
    "rule_description": {
      "type": "string"
    },
    "contract_page": {
      "type": "integer",
      "minimum": 1
    },
    "contract_clause_quote": {
      "type": "string",
      "description": "Verbatim contractual clause protecting the shipper"
    },
    "expected_amount": {
      "type": "string",
      "description": "Amount that should have been billed (Decimal string)"
    },
    "billed_amount": {
      "type": "string",
      "description": "Actual amount billed on invoice (Decimal string)"
    },
    "overcharge_amount": {
      "type": "string",
      "description": "Recoverable overcharge = billed - expected (Decimal string)"
    },
    "calculation_math": {
      "type": "string",
      "description": "Step-by-step arithmetic proof (e.g. 'Published $100 * (1 - 0.40 discount) = $60.00 expected vs $75.00 billed')"
    },
    "claim_deadline_date": {
      "type": "string",
      "format": "date",
      "description": "Calculated final deadline to file dispute based on claim_window_days"
    },
    "days_remaining_to_claim": {
      "type": "integer",
      "description": "Days remaining until dispute window closes (negative if expired)"
    },
    "status": {
      "type": "string",
      "enum": ["open", "included_in_dispute", "resolved", "dismissed"],
      "default": "open"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

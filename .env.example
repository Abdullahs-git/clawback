# ==============================================================================
# Clawback Environment Configuration Contract
# ==============================================================================

# Application Metadata
APP_NAME=Clawback
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite file volume by default, portable to PostgreSQL)
DATABASE_URL=sqlite:///./data/clawback.db

# Security & CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM & AMD Endpoint Configuration
# LLM_MODE options:
#   - 'live': makes live HTTP requests to AMD-hosted vLLM / Token Factory endpoint
#   - 'replay': serves verified pre-recorded real AMD model responses with full metrics badge
LLM_MODE=replay
LLM_BASE_URL=https://notebooks.amd.com/tokenfactory/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-2-9b-it
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Replay Cache Directory (stores JSON payloads recorded from real AMD calls)
REPLAY_CACHE_DIR=./backend/replay_cache

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./data/uploads

# Synthetic Data & Benchmark
BENCHMARK_OUTPUT_PATH=./benchmark/results.json
SYNTHETIC_DATA_DIR=./benchmark/data

# Optional Partner Integration: Evolus (Leave empty if not participating or no workspace code)
EVOLUS_API_KEY=
EVOLUS_WORKSPACE_ID=
EVOLUS_BASE_URL=https://app.evolus.ai/api/v1
